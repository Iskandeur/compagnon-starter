# Copie vers .env (git-ignoré), remplis les vraies valeurs. Ne committe jamais le fichier réel.

# PIN requis pour accéder au dashboard (page /login). Fortement recommandé dès que ce service est
# exposé au-delà de localhost — le dashboard donne une vue sur le fonctionnement interne de ton
# compagnon (jobs, coûts, réveils programmés…).
ACCESS_PIN=

# Signe le cookie de session émis après un PIN correct. Génère-en un avec :
#   openssl rand -hex 32
ACCESS_SESSION_SECRET=

# Port local sur lequel le conteneur est exposé, côté hôte (127.0.0.1 uniquement).
HOST_PORT=8790

# Chemins HÔTE (lecture seule) vers la base de ton harnais et ton dépôt git. Le harnais fourni par
# ce starter (harness/src/scheduler.ts) écrit déjà harness/data/wakes.sqlite — pointe dessus pour
# activer au moins le panneau Réveils. Les autres panneaux (Jobs, Sessions, Usage…) attendent un
# schéma plus riche que tu bâtis toi-même à mesure que ton daemon grandit — voir README.md,
# section "Contrat de données".
HOST_DB_PATH=/home/<user>/mon-compagnon/harness/data/wakes.sqlite
HOST_REPO_PATH=/home/<user>/mon-compagnon

# Jeton partagé avec ton daemon pour relayer des commandes de réglage (modèle/effort) depuis le
# dashboard. Doit correspondre à DASHBOARD_SETTINGS_TOKEN côté daemon. Laisse vide pour garder le
# panneau Réglages modèle en lecture seule (actions désactivées).
DASHBOARD_SETTINGS_TOKEN=

# Identifiant interne (ex. chat_id WhatsApp) d'un groupe optionnel que tu veux piloter séparément
# dans le panneau Réglages modèle. Vide = cette portée reste sur "hérite du global" (aucune clé
# settings ne matche), pas une erreur.
GROUP_SCOPE_CHAT_ID=
