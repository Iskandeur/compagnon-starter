# Copie vers .env (git-ignoré), remplis les vraies valeurs. Ne committe jamais le fichier réel.

# PIN requis pour accéder au dashboard (page /login). Obligatoire pour ce déploiement — le
# dashboard expose des métadonnées opérationnelles sur le fonctionnement interne de ton compagnon.
ACCESS_PIN=

# Signe le cookie de session émis après un PIN correct. Génère-en un avec :
#   openssl rand -hex 32
ACCESS_SESSION_SECRET=

# Port local sur lequel le conteneur est exposé, côté hôte (127.0.0.1 uniquement).
HOST_PORT=8790

# Chemins HÔTE (lecture seule) vers la base du harnais et le dépôt git. Ajuste selon où ton
# compagnon vit sur ta machine (exemple ci-dessous : un utilisateur "user").
COMPAGNON_DB_PATH=/home/<user>/mon-compagnon/data/compagnon.sqlite
COMPAGNON_REPO_PATH=/home/<user>/mon-compagnon

# Jeton partagé avec le daemon pour relayer les réglages modèle/effort depuis le dashboard. Doit
# correspondre au token attendu par ton service (route POST /settings côté harnais).
DASHBOARD_SETTINGS_TOKEN=

# Identifiant interne (chat_id) d'un groupe multi-agents nommé, pour le panneau Réglages modèle.
# Vide = cette portée reste sur "inherit" (aucune clé settings ne matche), pas une erreur.
GROUP_CHAT_ID=
